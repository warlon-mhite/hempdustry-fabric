uuuuiiiiiiiiiiii
uuuuiiiiiiiiiiii
iuuiiiiiiiiiiiii
iiiiiiiiiiiiiiii
iiiiiiiiiiiiiiii
iiiiiiiiiiiiiiii
iiiiiiiiiiiiiiii

# ---- what is in the pot ----
# One flat quad sunk into the tub, the same way vanilla draws a cauldron's water level. Drawn once
# and rendered through two palettes so the milk and the finished butter can never drift apart in
# anything but colour.
#
# Only `milk` is wired up today: the blockstate keys the brew on `filled`, per the design call that
# what makes a tub look full is liquid being in it and not something burning underneath. The block
# also carries `infusing`, and promoting it to a second brew colour is one line in the blockstate
# plus the model that already sits next to this comment.
@palette milk
. = none
c = E7E2D2
d = DDD7C4
e = F0ECDF

@palette butter extends=milk
c = C9A74B
d = B08B33
e = DEC271

@matrix brew_surface 16x16 palette=milk
cccccddcccccccdc
cceddccccceccdce
ccccccdcdceeddcd
ccdceeccccecccde
cccdcccccccecccc
cddccceeceececcc
dccddcdcccccccee
dccecdccddecccdc
ccdccecccdccceec
cccccdcccccccccd
ccddddcccdcdcccc
ccecccecccdecccc
cdeccecccddccccc
cccccccdddccccce
cccdedcdcdcccecc
deeccccccccedcce

@texture block/infuser_milk from=brew_surface palette=milk type=block
@texture block/infuser_butter from=brew_surface palette=butter type=block
