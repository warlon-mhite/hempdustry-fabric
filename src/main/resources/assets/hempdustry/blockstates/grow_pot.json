{
  "multipart": [
    {
      "when": {
        "watered": "false"
      },
      "apply": {
        "model": "hempdustry:block/grow_pot"
      }
    },
    {
      "when": {
        "watered": "true"
      },
      "apply": {
        "model": "hempdustry:block/grow_pot_watered"
      }
    },
    {
      "when": {
        "fertility": "1"
      },
      "apply": {
        "model": "hempdustry:block/grow_pot_compost_1"
      }
    },
    {
      "when": {
        "fertility": "2"
      },
      "apply": {
        "model": "hempdustry:block/grow_pot_compost_2"
      }
    },
    {
      "when": {
        "fertility": "3"
      },
      "apply": {
        "model": "hempdustry:block/grow_pot_compost_3"
      }
    }
  ]
}
