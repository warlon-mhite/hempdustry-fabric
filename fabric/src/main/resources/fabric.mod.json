{
	"schemaVersion": 1,
	"id": "hempdustry",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"Warlon Mhite"
	],
	"contributors": [
		"Nefu\u00df (music)"
	],
	"contact": {
		"homepage": "https://github.com/warlon-mhite/hempdustry-java",
		"sources": "https://github.com/warlon-mhite/hempdustry-java",
		"issues": "https://github.com/warlon-mhite/hempdustry-java/issues"
	},
	"license": [
		"AGPL-3.0-only",
		"CC-BY-NC-SA-4.0"
	],
	"icon": "assets/hempdustry/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.warlonmhite.hempdustry.fabric.HempdustryFabric"
		],
		"fabric-datagen": [
			"com.warlonmhite.hempdustry.HempdustryDataGenerator"
		],
		"client": [
			"com.warlonmhite.hempdustry.fabric.client.HempdustryFabricClient"
		],
		"emi": [
			"com.warlonmhite.hempdustry.compat.emi.HempdustryEmiPlugin"
		],
		"jei_mod_plugin": [
			"com.warlonmhite.hempdustry.compat.jei.HempdustryJeiPlugin"
		],
		"rei_client": [
			"com.warlonmhite.hempdustry.compat.rei.HempdustryReiPlugin"
		]
	},
	"accessWidener": "hempdustry.accesswidener",
	"mixins": [
		"hempdustry.mixins.json",
		{
			"config": "hempdustry.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": ">=0.92.2"
	}
}
