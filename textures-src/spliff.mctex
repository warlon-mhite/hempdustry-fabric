# Both spliffs, and the tint mask that goes over them.
#
# The MATRIX is Warlon Mhite's own hand-drawn spliff, traced pixel for pixel; only the PALETTE
# is ours, and it moves in one place: the three paper greys pick up a tint so the two strains
# tell apart in a hotbar without a second drawing. Purple Kush takes a cool violet, Lemon Haze
# a warm cream. The ember is fire in both and is left alone.
#
# Re-render with:
#   python3 .claude/skills/minecraft-texture-painter/scripts/mctex.py render \
#     textures-src/spliff.mctex -o src/main/resources/assets/hempdustry/textures \
#     --preview --preview-dir /tmp/tex-preview
#
# If the drawing is ever redrawn, re-trace the matrix from it AND move item/spliff_load with
# it -- that mask has to sit exactly on the lit tip, see below.

@palette spliff_kush
. = none
# the ember, untinted in both strains
e = E82651
E = E86D32
# the paper, tinted cool violet: k is the shaded lower-right rim, m the lit upper-left one,
# p the paper itself. Vanilla items rim at about 0.55x the interior brightness, which is much
# darker than it feels while drawing.
k = 5F5866
m = 8C8496
p = B6AEC4

@palette spliff_lemon extends=spliff_kush
k = 635C4E
m = 8F8672
p = B8AC92

@matrix spliff_roll 16x16 palette=spliff_kush
................
................
...EeE..........
..EeeEk.........
..mEeEmk........
...mpppmk.......
....mpppmk......
.....mpppmk.....
......mppmk.....
.......mppmk....
........mppmk...
.........mpmk...
..........mpmk..
...........mpk..
................
................

@texture item/indica_spliff from=spliff_roll palette=spliff_kush type=item
@texture item/sativa_spliff from=spliff_roll palette=spliff_lemon type=item

# ---- the strain tint mask ----
# item/spliff.json draws item/indica_spliff on layer0 and this on layer1, where it is multiplied
# by Strain.color -- it is the only visual identity a datapack strain can have (smoking.md). So it
# must cover EXACTLY the ten lit-tip pixels of the matrix above and nothing else, and it must be
# grey: a multiply can never lighten, so the mask's own tone sets the ceiling.
@palette load
. = none
1 = 545454
2 = 5B5B5B
3 = 717171
4 = 7D7D7D
5 = 808080
6 = 8A8A8A

@texture item/spliff_load 16x16 type=item palette=load
................
................
...456..........
..2345..........
...234..........
................
................
................
................
................
................
................
................
................
................
................
