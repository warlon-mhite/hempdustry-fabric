# Both hemp seeds.
#
# The MATRIX is Warlon Mhite's own hand-drawn item/sativa_seeds.png, traced pixel for pixel; only
# the PALETTE is ours. The two strains shipped one identical PNG, so a hotbar could not tell a
# Purple Kush seed from a Lemon Haze one. Each keeps the same three-tone seed brown and leans a
# step towards its strain's colour: Purple Kush a cool violet-grey, Lemon Haze a warm olive.
# toasted_hemp_seeds (seed_food.mctex) traces the same scatter.

@palette seeds_kush
. = none
1 = 2C2830
2 = 5E4B5A
3 = 7E6878

@palette seeds_lemon
. = none
1 = 2F2D1E
2 = 6E5F2E
3 = 938043

@matrix seed_scatter 16x16 palette=seeds_kush
................
................
.........12.....
........123.....
....21..13......
...232..........
...11......21...
.......31..321..
......211...31..
......31........
..32......23....
..132....321....
...31....11.....
................
................
................

@texture item/indica_seeds from=seed_scatter palette=seeds_kush type=item
@texture item/sativa_seeds from=seed_scatter palette=seeds_lemon type=item
