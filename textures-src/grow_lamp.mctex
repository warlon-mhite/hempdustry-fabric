p = 583193
q = 6036A0
r = 693BAF
s = 24153B      the lamp, lit: redstone_lamp_on's six
t = 281446
u = 593194
v = 8A3CFF      UV violet, the blurple of an LED grow light
w = A674F2
x = CDB0FF      lavender hot spot

