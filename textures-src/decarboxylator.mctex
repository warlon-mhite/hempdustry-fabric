# PLACEHOLDER art for the Decarboxylator and the two cannabutter-chain intermediates.
# Warlon Mhite intends to redraw these; keep this spec in sync if one is tweaked, or delete
# the entry once real art lands (CLAUDE.md §4).
#
# The brick digits 1-9 are sampled straight out of the shipping hemp_bricks_block.png, so the
# oven's top and front sit in the same palette as the rest of the mod's hemp masonry and the
# block model can reuse hemp_bricks_block for its sides and bottom.

@palette brick
. = none
1 = 67663F
2 = 6F6D45
3 = 807B50
4 = 887B6A
5 = 8A8456
6 = 9E9362
7 = 9F9380
8 = B0A06A
9 = A79E8F
# recessed grate, cold
g = 241F14
k = 3A3222
# grate glowing, and the copper flue
o = 8A3B10
p = C25A18
q = E8912E
a = 7A4433
b = A8624A
c = C97F5C
e = E09A72

