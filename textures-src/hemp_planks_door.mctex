@slice block/hemp_planks_door_top    0  0 16 16 type=block
@slice block/hemp_planks_door_bottom 0 16 16 16 type=block

# The item icon is a schematic of the block, the way vanilla's door items are:
# the leaf window becomes a plain round light, because five leaflets inside six
# pixels is mush at hotbar size.
@texture item/hemp_planks_door 16x16 type=item palette=hemp
