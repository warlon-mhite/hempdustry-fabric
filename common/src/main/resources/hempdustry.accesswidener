accessible method net/minecraft/world/level/block/TrapDoorBlock <init> (Lnet/minecraft/world/level/block/state/properties/BlockSetType;Lnet/minecraft/world/level/block/state/BlockBehaviour$Properties;)V

# Which tabs a stack shows in: the creative tab puts showcase stacks in the tab and leaves the
# search tab the plain ones.
accessible class net/minecraft/world/item/CreativeModeTab$TabVisibility
# The output the tab's items are handed to, protected since 26.1.
accessible class net/minecraft/world/item/CreativeModeTab$Output

# The water cauldron's interactions: since 26.1 they live in a dispatcher whose put is package-private,
# and vanilla's own registrations are its only callers.
accessible method net/minecraft/core/cauldron/CauldronInteraction$Dispatcher put (Lnet/minecraft/world/item/Item;Lnet/minecraft/core/cauldron/CauldronInteraction;)V

