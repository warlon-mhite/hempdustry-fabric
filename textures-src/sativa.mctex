# PLACEHOLDER art for the Lemon Haze (sativa) strain.
#
# Re-render with:
#   python3 .claude/skills/minecraft-texture-painter/scripts/mctex.py render \
#     textures-src/sativa.mctex -o src/main/resources/assets/hempdustry/textures \
#     --preview --preview-dir /tmp/tex-preview
#
# Not covered here: item/sativa_buds.png and the block/sativa_crop_stage*.png set
# are hand-drawn art that already shipped, and item/sativa_seeds.png is a straight
# copy of item/indica_seeds.png (hemp seed is hemp seed).
#
# The spliff moved out to textures-src/spliff.mctex, which now carries both strains'
# rolls off one matrix. The wild flower is drawn fresh, in the same palette as the
# sativa_crop_stage*.png textures it stands next to.




# ---------------------------------------------------------------------------
# Wild Lemon Haze — the cross-model flower block. Palette is lifted straight off
# the sativa_crop_stage*.png set (bright lime greens + the gold of a flowering
# top), which is what sets it apart from the muted grey-green Wild Purple Kush.
# Lanky single stalk, leaflets in loose whorls, gold cola on top — sativa's
# profile against indica's bush.
# ---------------------------------------------------------------------------

@palette flower_lemon
. = none
s = 435949
d = 549154
m = 6BB269
l = 95BBA9
b = BE6800
g = D88520
h = EE9829

@texture block/sativa_flower 16x16 palette=flower_lemon type=plant
