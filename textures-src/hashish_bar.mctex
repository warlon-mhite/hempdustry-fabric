@texture block/hashish_bar_top from=bar_top palette=resin type=block tiling=true
@texture block/hashish_bar_side from=bar_side palette=resin type=block tiling=true
@texture block/filtered_hashish_bar_top from=bar_top palette=resin_blonde type=block tiling=true
@texture block/filtered_hashish_bar_side from=bar_side palette=resin_blonde type=block tiling=true
