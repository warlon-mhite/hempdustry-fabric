# The seed: Lemon Haze's seed matrix (itself a copy of Purple Kush's), paler and greyer -- fibre
# cultivars' seed is the light, mottled kind sold as bird feed, and a hotbar has to tell it apart.
@palette seed
. = none
1 = 4A4636
2 = 8C7E5A
3 = B3A57C

