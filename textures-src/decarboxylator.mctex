# ---- the two intermediates ----
# One heap, two palettes: washing changes the colour, not the shape, and sharing the matrix is
# what guarantees the pair stay recognisably the same pile at two stages.

@palette toasted
. = none
O = 3D2410
d = 5A3618
m = 8A5626
h = B37C3A
H = E8B863

@palette washed
. = none
O = 3A4020
d = 5E6A34
m = 8C9A52
h = B3C077
H = DCE6A8

# A loose pile, not a baked loaf: the top contour is deliberately lumpy (two humps with a
# notch) and the interior is speckled between tones, so it reads as crumbled material rather
# than one smooth solid. A clean dome here looked exactly like a bread roll.
@matrix heap 16x16 palette=toasted
................
................
................
.....OO..OO.....
....OhhOOhhO....
...OhHhhhHhhO...
..OhHhhmmhHhmO..
..OhhhmmmhmmdO..
..OhhmmdmmmddO..
..OhmmmmdmdddO..
.OhmmdmmmddmddO.
.OmmdmdddmddddO.
.OmdddddmdddddO.
.OdddmddddddddO.
.OOOOOOOOOOOOOO.
................

@texture item/decarboxylated_hemp from=heap palette=toasted type=item
@texture item/washed_decarboxylated_hemp from=heap palette=washed type=item

# ---- empty-slot hints ----
# Served by Slot#getBackgroundSprite off the block atlas (which is why they live under item/,
# exactly like vanilla's empty_armor_slot_* sprites) so the game hides them the moment the slot
# holds something.
#
# Style is copied from vanilla rather than guessed: extracting
# assets/minecraft/textures/item/empty_armor_slot_helmet.png gives a ONE-colour #555555 1px
# outline drawing, not a filled shaded sprite. Running these two through the linter alongside
# vanilla's own shows vanilla's tripping *more* findings than ours — flat, spindly, 28% fill and
# 60% whiskers. That is the convention for this class of sprite: it is a hint, not an item, and
# it must not compete with a real item for attention. The [fix] findings on both of these are
# knowingly accepted for exactly that reason.
@palette hint
. = none
1 = 555555

# A flame: "anything that burns goes here" — coal, a lava bucket, hemp stem, a bale.
@texture item/empty_slot_fuel 16x16 type=item palette=hint
................
................
