{
	"schemaVersion": 1,
	"id": "hempdustry",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"Warlon Mhite"
	],
	"contributors": [
		"Nefu\u00df (music)"
	],
	"contact": {
		"homepage": "https://github.com/warlon-mhite/hempdustry-fabric",
		"sources": "https://github.com/warlon-mhite/hempdustry-fabric",
		"issues": "https://github.com/warlon-mhite/hempdustry-fabric/issues"
	},
	"license": [
		"AGPL-3.0-only",
		"CC-BY-NC-SA-4.0"
	],
	"icon": "assets/hempdustry/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.warlonmhite.hempdustry.fabric.HempdustryFabric"
		],
		"fabric-datagen": [
			"com.warlonmhite.hempdustry.HempdustryDataGenerator"
		],
		"client": [
			"com.warlonmhite.hempdustry.fabric.client.HempdustryFabricClient"
		],
		"jei_mod_plugin": [
			"com.warlonmhite.hempdustry.compat.jei.HempdustryJeiPlugin"
		],
		"rei_client": [
			"com.warlonmhite.hempdustry.compat.rei.HempdustryReiPlugin"
		],
		"rei_common": [
			"com.warlonmhite.hempdustry.compat.rei.HempdustryReiCommonPlugin"
		]
	},
	"accessWidener": "hempdustry.accesswidener",
	"mixins": [
		"hempdustry.mixins.json",
		{
			"config": "hempdustry.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": ">=1.21.11 <1.21.12",
		"java": ">=21",
		"fabric-api": ">=0.139.4"
	}
}
