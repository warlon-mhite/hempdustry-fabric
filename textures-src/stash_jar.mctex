# The Stash Jar: the item's layers (back, five stash pieces and their pistils, a front per tier)
# and the placed jar's glass, stash and pistils. The pieces are grey on purpose: each body is
# tinted bud green (schwag brown) and its pistils its strain's colour, a multiply, as vanilla
# tints grass. Glass blues from vanilla's glass and glass
# bottle, the lid from hemp_planks, the bands from vanilla's gold ingot and diamond.

@palette default
. = none
# glass, darkest to lightest
a = 3E6E8F
b = 5D8FC2
c = 8BADD0
d = B3CFEC
e = D4E5F7
# hemp-wood lid
o = 3F3A26
1 = 5A5236
2 = 67603E
3 = 82794E
4 = 948A5E
5 = A89D73
# gold band
G = 752802
H = B26411
I = DC9613
J = FAD64A
K = FFFDE0
# diamond trim
P = 145E53
Q = 1C919A
R = 20C5B5
S = 4AEDD9
T = D5FFF6
# stash greys, multiplied by the strain's colour
w = 7E7E7E
x = BDBDBD
y = E2E2E2
z = FFFFFF

