# Datagen hash cache (not part of the mod)
common/src/generated/resources/.cache/

# NOTE: common/src/generated/resources/ is intentionally NOT ignored.
# Every loader's jar ships it, so the datagen output must stay committed
# for a clean clone to build a working mod. Regenerate it with
# `./gradlew :fabric:runDatagen`.

# Python bytecode from the textures-src generators
__pycache__/
